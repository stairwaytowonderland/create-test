{
	"$schema": "https://typedoc.org/schema.json",
	"logLevel": "Verbose",
	"readme": "none",
	"disableSources": true,
	"entryPointStrategy": "expand",
	"entryPoints": ["src"],
	"sort": ["kind", "instance-first", "required-first", "external-last", "alphabetical"],
	"sortEntryPoints": true,
	"out": "./docs",
	"exclude": [
		"**/__tests__/**",
		"**/__fixtures__/**",
		"**/__utils__/**",
		"**/docs/**",
		"**/*.test.ts",
		"**/index.ts",
		"**/main.ts"
	]
}
